---
import { AUTHOR_NAME, SOCIAL_LINKS } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<div class="footer-inner">
		<p>&copy; {year} {AUTHOR_NAME}. Built with Astro.</p>
		<div class="footer-links">
			<a href={SOCIAL_LINKS.github} target="_blank" rel="noreferrer">GitHub</a>
			<a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
			<a href={SOCIAL_LINKS.x} target="_blank" rel="noreferrer">X</a>
			<a href={SOCIAL_LINKS.email}>Email</a>
		</div>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border-color);
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: min(100% - 2rem, 1080px);
		margin: 0 auto;
		padding: 1.5rem 0 2.5rem;
	}

	p {
		margin: 0;
	}

	.footer-links {
		display: flex;
		gap: 1rem;
	}

	.footer-links a {
		color: var(--text-muted);
	}

	.footer-links a:hover {
		color: var(--accent);
	}

	@media (max-width: 640px) {
		footer {
			font-size: 0.86rem;
		}

		.footer-inner {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.85rem;
			width: min(100% - 2rem, 1080px);
			padding: 1.25rem 0 2rem;
		}

		.footer-links {
			flex-wrap: wrap;
			gap: 0.35rem;
			width: 100%;
		}

		.footer-links a {
			border: 1px solid var(--border-color);
			border-radius: 6px;
			min-height: 36px;
			padding: 0.35rem 0.65rem;
		}

		.footer-links a:hover {
			border-color: color-mix(in srgb, var(--accent) 45%, var(--border-color));
			background: color-mix(in srgb, var(--accent) 8%, transparent);
		}
	}

	@media (max-width: 360px) {
		.footer-links {
			display: grid;
			grid-template-columns: 1fr 1fr;
		}

		.footer-links a {
			text-align: center;
		}
	}
</style>
