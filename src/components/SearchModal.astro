---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((post) => ({
		title: post.data.title,
		description: post.data.description,
		date: post.data.pubDate.toLocaleDateString('en-US', {
			month: 'short',
			day: 'numeric',
			year: 'numeric',
		}),
		url: `/blog/${post.id}/`,
	}));
---

<site-search>
	<button class="search-trigger" data-open-search aria-label="Search posts" aria-keyshortcuts="Control+K">
		<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
			<circle cx="11" cy="11" r="8"></circle>
			<path d="m21 21-4.35-4.35"></path>
		</svg>
		<span>Search</span>
		<kbd><span data-platform-key>Ctrl</span><span>K</span></kbd>
	</button>

	<dialog aria-label="Search posts">
		<div class="search-panel">
			<form class="search-form" role="search">
				<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<circle cx="11" cy="11" r="8"></circle>
					<path d="m21 21-4.35-4.35"></path>
				</svg>
				<input class="search-input" type="search" placeholder="Search posts..." autocomplete="off" spellcheck="false" />
				<button class="search-close" type="button" data-close-search aria-label="Close search">
					<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M18 6 6 18"></path>
						<path d="m6 6 12 12"></path>
					</svg>
				</button>
			</form>
			<div class="search-state" data-state>Type to search the blog archive.</div>
			<ul class="search-results" data-results></ul>
		</div>
	</dialog>
</site-search>

<script define:vars={{ posts }}>
	(() => {
		const isMac = /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform);
		document.querySelectorAll('[data-platform-key]').forEach((element) => {
			element.textContent = isMac ? 'Cmd' : 'Ctrl';
		});
		document.querySelectorAll('[data-open-search]').forEach((button) => {
			button.setAttribute('aria-keyshortcuts', isMac ? 'Meta+K' : 'Control+K');
		});

		class SiteSearch extends HTMLElement {
			connectedCallback() {
				const openButton = this.querySelector('[data-open-search]');
				const dialog = this.querySelector('dialog');
				const closeButton = this.querySelector('[data-close-search]');
				const form = this.querySelector('.search-form');
				const input = this.querySelector('.search-input');
				const state = this.querySelector('[data-state]');
				const results = this.querySelector('[data-results]');

				if (!openButton || !dialog || !closeButton || !form || !input || !state || !results) return;

				const escapeHtml = (value) =>
					value.replace(/[&<>"']/g, (char) => ({
						'&': '&amp;',
						'<': '&lt;',
						'>': '&gt;',
						'"': '&quot;',
						"'": '&#039;',
					})[char]);

				const render = (query) => {
					const normalized = query.trim().toLowerCase();
					results.innerHTML = '';

					if (!normalized) {
						state.textContent = 'Type to search the blog archive.';
						return;
					}

					const matches = posts.filter((post) => {
						const haystack = `${post.title} ${post.description} ${post.date}`.toLowerCase();
						return haystack.includes(normalized);
					});

					if (matches.length === 0) {
						state.textContent = `No posts found for "${query}".`;
						return;
					}

					state.textContent = `${matches.length} result${matches.length === 1 ? '' : 's'} for "${query}".`;
					results.innerHTML = matches
						.map(
							(post) => `
								<li>
									<a href="${post.url}">
										<span class="result-title">${escapeHtml(post.title)}</span>
										<span class="result-date">${escapeHtml(post.date)}</span>
										<span class="result-description">${escapeHtml(post.description)}</span>
									</a>
								</li>
							`,
						)
						.join('');
				};

				const close = () => {
					if (!dialog.open) return;
					dialog.close();
					document.body.toggleAttribute('data-search-modal-open', false);
					input.value = '';
					render('');
				};

				const open = () => {
					if (dialog.open) {
						input.focus();
						return;
					}
					dialog.showModal();
					document.body.toggleAttribute('data-search-modal-open', true);
					requestAnimationFrame(() => input.focus());
				};

				openButton.addEventListener('click', open);
				closeButton.addEventListener('click', close);
				form.addEventListener('submit', (event) => event.preventDefault());
				input.addEventListener('input', () => render(input.value));
				dialog.addEventListener('click', (event) => {
					if (event.target === dialog) close();
				});

				document.addEventListener('keydown', (event) => {
					if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
						event.preventDefault();
						open();
					}

					if (event.key === 'Escape') {
						close();
					}
				});
			}
		}

		customElements.define('site-search', SiteSearch);
	})();
</script>

<style>
	site-search {
		display: flex;
	}

	.search-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		height: 36px;
		border: 1px solid var(--border-color);
		border-radius: 6px;
		background: transparent;
		color: var(--text-secondary);
		cursor: pointer;
		font: inherit;
		font-size: 0.875rem;
		padding: 0 0.65rem;
		transition:
			background-color 0.15s ease,
			color 0.15s ease,
			border-color 0.15s ease;
	}

	.search-trigger:hover {
		background: var(--bg-secondary);
		color: var(--text-primary);
		border-color: color-mix(in srgb, var(--accent) 35%, var(--border-color));
	}

	.search-trigger kbd {
		display: inline-flex;
		gap: 0.15rem;
		color: var(--text-muted);
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.68rem;
	}

	.search-trigger kbd span {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 1.2rem;
		height: 1.2rem;
		border: 1px solid var(--border-color);
		border-radius: 4px;
		background: var(--bg-secondary);
		padding: 0 0.25rem;
	}

	dialog {
		width: min(92vw, 42rem);
		max-height: 78vh;
		border: 1px solid var(--border-color);
		border-radius: 10px;
		background: var(--bg-primary);
		color: var(--text-secondary);
		box-shadow: 0 24px 80px rgba(var(--shadow-color), 0.24);
		margin: auto;
		padding: 0;
		overflow: hidden;
	}

	dialog::backdrop {
		background: rgba(0, 0, 0, 0.45);
		backdrop-filter: blur(4px);
	}

	.search-panel {
		display: flex;
		min-height: 0;
		max-height: 78vh;
		flex-direction: column;
	}

	.search-form {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		border-bottom: 1px solid var(--border-color);
		background: var(--bg-secondary);
		padding: 1rem 1.1rem;
	}

	.search-form svg {
		color: var(--text-muted);
		flex: 0 0 auto;
	}

	.search-close {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 auto;
		width: 34px;
		height: 34px;
		border: 0;
		border-radius: 6px;
		background: transparent;
		color: var(--text-muted);
		cursor: pointer;
		padding: 0;
	}

	.search-close:hover {
		background: var(--bg-tertiary);
		color: var(--text-primary);
	}

	.search-input {
		width: 100%;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--text-primary);
		font: inherit;
		font-size: 1rem;
	}

	.search-state {
		border-bottom: 1px solid var(--border-color);
		color: var(--text-muted);
		font-size: 0.85rem;
		padding: 0.75rem 1.1rem;
	}

	.search-results {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		list-style: none;
		margin: 0;
		max-height: 24rem;
		min-height: 0;
		overflow-y: auto;
		padding: 0.75rem;
	}

	.search-results:empty {
		display: none;
	}

	.search-results a {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.35rem 1rem;
		border: 1px solid var(--border-color);
		border-radius: 8px;
		background: var(--bg-secondary);
		color: inherit;
		padding: 0.9rem 1rem;
	}

	.search-results a:hover {
		border-color: color-mix(in srgb, var(--accent) 45%, var(--border-color));
		background: color-mix(in srgb, var(--accent) 7%, var(--bg-secondary));
	}

	.result-title {
		color: var(--text-primary);
		font-weight: 700;
	}

	.result-date {
		color: var(--text-muted);
		font-size: 0.78rem;
		white-space: nowrap;
	}

	.result-description {
		grid-column: 1 / -1;
		color: var(--text-muted);
		font-size: 0.9rem;
		line-height: 1.5;
	}

	@media (max-width: 640px) {
		site-search {
			flex: 0 0 auto;
		}

		.search-trigger {
			justify-content: center;
			width: 36px;
			padding: 0;
		}

		.search-trigger span:not([data-platform-key]) {
			display: none;
		}

		.search-trigger kbd {
			display: none;
		}

		dialog {
			width: 100vw;
			max-width: none;
			height: 100vh;
			height: 100dvh;
			max-height: 100vh;
			max-height: 100dvh;
			margin: 0;
			border: 0;
			border-radius: 0;
		}

		.search-panel {
			height: 100vh;
			height: 100dvh;
			max-height: 100vh;
			max-height: 100dvh;
			padding-top: env(safe-area-inset-top);
			padding-bottom: env(safe-area-inset-bottom);
		}

		.search-form {
			padding: 0.85rem 1rem;
		}

		.search-input {
			font-size: 1rem;
		}

		.search-state {
			padding: 0.7rem 1rem;
		}

		.search-results {
			flex: 1;
			max-height: none;
			padding: 0.65rem;
		}

		.search-results a {
			grid-template-columns: 1fr;
			gap: 0.25rem;
			padding: 0.8rem 0.85rem;
		}

		.result-date {
			white-space: normal;
		}
	}
</style>
