---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SearchModal from './SearchModal.astro';
---

<script is:inline>
	(() => {
		const key = 'zen-theme';
		const stored = localStorage.getItem(key);
		const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
		const theme = stored || 'auto';

		if (theme === 'dark' || (theme === 'auto' && prefersDark)) {
			document.documentElement.classList.add('dark');
		}
	})();
</script>

<header>
	<nav>
		<div class="nav-left">
			<h2><a href="/">{SITE_TITLE}</a></h2>
		</div>
		<div class="nav-center">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/tags">Tags</HeaderLink>
			<HeaderLink href="/projects">Projects</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="nav-right">
			<SearchModal />
			<button id="theme-toggle" class="nav-btn" type="button" aria-label="Theme" title="Theme">
				<svg id="theme-icon" aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<circle cx="12" cy="12" r="5"></circle>
					<path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
				</svg>
			</button>
			<div id="theme-menu" class="theme-menu" aria-label="Theme options">
				<button type="button" data-theme="light" aria-label="Light theme" title="Light">
					<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<circle cx="12" cy="12" r="5"></circle>
						<path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
					</svg>
				</button>
				<button type="button" data-theme="dark" aria-label="Dark theme" title="Dark">
					<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M21 12.79A9 9 0 1 1 11.21 3A7 7 0 0 0 21 12.79z"></path>
					</svg>
				</button>
				<button type="button" data-theme="auto" aria-label="Auto theme" title="Auto">
					<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path>
						<path d="M3 3v5h5"></path>
					</svg>
				</button>
			</div>
		</div>
	</nav>
</header>

<script>
	const storageKey = 'zen-theme';
	const toggle = document.getElementById('theme-toggle');
	const menu = document.getElementById('theme-menu');
	const icon = document.getElementById('theme-icon');
	const media = window.matchMedia('(prefers-color-scheme: dark)');

	const icons = {
		light:
			'<circle cx="12" cy="12" r="5"></circle><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>',
		dark: '<path d="M21 12.79A9 9 0 1 1 11.21 3A7 7 0 0 0 21 12.79z"></path>',
		auto: '<path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path><path d="M3 3v5h5"></path>',
	};

	function preferredTheme() {
		return localStorage.getItem(storageKey) || 'auto';
	}

	function applyTheme(theme = preferredTheme()) {
		const active = theme === 'auto' ? (media.matches ? 'dark' : 'light') : theme;
		document.documentElement.classList.toggle('dark', active === 'dark');
		if (icon) icon.innerHTML = icons[theme] || icons.auto;
	}

	function closeMenu() {
		menu?.classList.remove('show');
	}

	applyTheme();
	toggle?.addEventListener('click', (event) => {
		event.stopPropagation();
		menu?.classList.toggle('show');
	});

	menu?.addEventListener('click', (event) => {
		const button = (event.target as HTMLElement).closest('[data-theme]') as HTMLButtonElement | null;
		if (!button) return;
		localStorage.setItem(storageKey, button.dataset.theme || 'auto');
		applyTheme();
		closeMenu();
	});

	document.addEventListener('click', closeMenu);
	media.addEventListener('change', () => {
		if (preferredTheme() === 'auto') applyTheme('auto');
	});
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		width: 100%;
		border-bottom: 1px solid var(--border-color);
		background-color: rgba(255, 255, 255, 0.95);
		backdrop-filter: blur(8px);
	}

	html.dark header {
		background-color: rgba(24, 24, 27, 0.95);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: 1200px;
		height: 64px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	.nav-left {
		flex: 0 0 auto;
	}

	h2 {
		margin: 0;
		font-size: 1.125rem;
		font-weight: 700;
	}

	h2 a,
	h2 a.active {
		color: var(--text-primary);
		font-weight: 700;
		text-decoration: none;
	}

	.nav-center {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 2rem;
	}

	.nav-center a {
		border-bottom: 2px solid transparent;
		color: var(--text-secondary);
		font-size: 0.875rem;
		font-weight: 500;
		padding: 0.5rem 0;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.nav-center a:hover,
	.nav-center a.active {
		color: var(--accent);
	}

	.nav-center a.active {
		border-bottom-color: var(--accent);
		font-weight: 700;
	}

	.nav-right {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		position: relative;
	}

	.nav-btn,
	.theme-menu button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border: 0;
		border-radius: 0.5rem;
		background: transparent;
		color: var(--text-muted);
		cursor: pointer;
		padding: 0;
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
	}

	.nav-btn:hover,
	.theme-menu button:hover {
		background: var(--bg-secondary);
		color: var(--accent);
	}

	.theme-menu {
		position: absolute;
		top: calc(100% + 8px);
		right: 0;
		display: grid;
		gap: 0.2rem;
		border: 1px solid var(--border-color);
		border-radius: 0.75rem;
		background: var(--bg-primary);
		box-shadow: 0 4px 20px rgba(var(--shadow-color), 0.15);
		padding: 0.25rem;
		opacity: 0;
		pointer-events: none;
		transform: translateY(-8px);
		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
		z-index: 200;
	}

	.theme-menu.show {
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0);
	}

	@media (max-width: 760px) {
		nav {
			height: auto;
			flex-wrap: wrap;
			padding: 0.75rem 1rem;
		}

		.nav-center {
			order: 3;
			width: 100%;
			justify-content: flex-start;
			gap: 1rem;
			overflow-x: auto;
		}

		.nav-center a {
			line-height: 2.2;
			white-space: nowrap;
		}
	}
</style>
