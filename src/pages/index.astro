---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { AUTHOR_DESCRIPTION, AUTHOR_NAME, AUTHOR_TITLE, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 4);

const formatDate = (date: Date) =>
	date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro-section">
				<div class="avatar-wrapper">
					<img
						class="intro-avatar"
						src="https://avatars.githubusercontent.com/u/3953162?v=4"
						alt={AUTHOR_NAME}
						width="96"
						height="96"
					/>
				</div>
				<div class="intro-content">
					<h1 class="intro-title">Hello, I'm {AUTHOR_NAME}</h1>
					<p class="intro-subtitle">{AUTHOR_TITLE}</p>
					<p class="intro-description">{AUTHOR_DESCRIPTION}</p>
				</div>
			</section>

			<section class="posts-section">
				<div class="section-header">
					<h2 class="section-title">Latest Posts</h2>
					<a href="/blog" class="section-link">View All -&gt;</a>
				</div>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li class="post-item">
								<a href={`/blog/${post.id}/`} class="post-link">
									<span class="post-date">{formatDate(post.data.pubDate)}</span>
									<h3 class="post-title">{post.data.title}</h3>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section class="projects-section">
				<div class="section-header">
					<h2 class="section-title">Projects</h2>
					<a href="/projects" class="section-link">Open Projects -&gt;</a>
				</div>
				<p class="projects-description">
					Small tools, experiments, and notes from building software with a focus on clarity and
					maintainability.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	:global(body) {
		min-height: 100vh;
	}

	main {
		max-width: 640px;
		padding-inline: 1.5rem;
	}

	.intro-section {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		padding: 2.5rem 0 2rem;
	}

	.avatar-wrapper {
		flex-shrink: 0;
	}

	.intro-avatar {
		width: 96px;
		height: 96px;
		border-radius: 50%;
		object-fit: cover;
		border: 3px solid transparent;
		background:
			linear-gradient(var(--bg-primary), var(--bg-primary)) padding-box,
			linear-gradient(135deg, var(--accent), #8b5cf6) border-box;
		box-shadow: 0 8px 30px color-mix(in srgb, var(--accent) 22%, transparent);
	}

	.intro-content {
		flex: 1;
		min-width: 0;
	}

	.intro-title {
		margin: 0 0 0.375rem;
		color: var(--text-primary);
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: 0;
	}

	.intro-subtitle {
		margin: 0 0 0.75rem;
		color: var(--accent);
		font-size: 1rem;
		font-weight: 600;
	}

	.intro-description {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.9rem;
		line-height: 1.7;
	}

	.posts-section {
		margin-top: 1.5rem;
		padding-bottom: 1.5rem;
	}

	.projects-section {
		padding-bottom: 1.5rem;
	}

	.section-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
		border-top: 1px solid var(--border-color);
		padding-top: 1.5rem;
	}

	.section-title {
		position: relative;
		margin: 0;
		padding-left: calc(3px + 0.5rem);
		color: var(--text-primary);
		font-size: 1.125rem;
		font-weight: 700;
	}

	.section-title::before {
		position: absolute;
		top: 50%;
		left: 0;
		width: 3px;
		height: 1.125rem;
		border-radius: 2px;
		background: linear-gradient(180deg, var(--accent), #8b5cf6);
		content: "";
		transform: translateY(-50%);
	}

	.post-list {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		list-style: none;
		margin: 0;
		padding-left: calc(3px + 0.5rem);
	}

	.section-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		border-radius: 0.5rem;
		background: color-mix(in srgb, var(--accent) 12%, transparent);
		color: var(--accent);
		font-size: 0.875rem;
		font-weight: 700;
		padding: 0.5rem 1.25rem;
		text-decoration: none;
		transition:
			background-color 0.2s ease,
			color 0.2s ease,
			transform 0.2s ease;
	}

	.section-link:hover {
		background: var(--accent);
		color: var(--bg-primary);
		text-decoration: none;
		transform: translateY(-2px);
	}

	.post-item {
		border-bottom: 1px solid color-mix(in srgb, var(--border-color) 65%, transparent);
		padding: 1rem 0;
		transition: background-color 0.15s ease;
	}

	.post-item:last-child {
		border-bottom: 0;
	}

	.post-item:hover {
		background: color-mix(in srgb, var(--accent) 8%, transparent);
	}

	.post-link {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		text-decoration: none;
	}

	.post-date {
		flex-shrink: 0;
		min-width: 70px;
		color: var(--text-muted);
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		text-align: left;
	}

	.post-title {
		flex: 1;
		margin: 0;
		color: var(--text-primary);
		font-size: 0.95rem;
		font-weight: 500;
		line-height: 1.5;
		text-align: left;
		transition: color 0.15s ease;
	}

	.post-link:hover .post-title {
		color: var(--accent);
	}

	.projects-description {
		margin: 0;
		padding-left: calc(3px + 0.5rem);
		color: var(--text-muted);
		font-size: 0.9rem;
		line-height: 1.7;
	}

	html.dark .section-link:hover {
		color: #18181b;
	}

	@media (max-width: 640px) {
		main {
			max-width: 100%;
			padding-inline: 1rem;
		}

		.intro-section {
			align-items: flex-start;
			gap: 1rem;
			padding: 1.75rem 0 1.25rem;
		}

		.intro-avatar {
			width: 72px;
			height: 72px;
			border-width: 2px;
		}

		.intro-title {
			font-size: 1.45rem;
			line-height: 1.25;
		}

		.intro-subtitle {
			margin-bottom: 0.5rem;
			font-size: 0.95rem;
			line-height: 1.4;
		}

		.intro-description,
		.projects-description {
			font-size: 0.88rem;
			line-height: 1.65;
		}

		.posts-section {
			margin-top: 1rem;
		}

		.section-header {
			align-items: flex-start;
			gap: 0.75rem;
			margin-bottom: 0.75rem;
			padding-top: 1.25rem;
		}

		.section-title {
			font-size: 1.05rem;
		}

		.section-link {
			flex: 0 0 auto;
			font-size: 0.8rem;
			line-height: 1.2;
			padding: 0.45rem 0.75rem;
			white-space: nowrap;
		}

		.post-list,
		.projects-description {
			padding-left: 0;
		}

		.post-item {
			padding: 0.85rem 0;
		}

		.post-link {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.25rem;
		}

		.post-date {
			min-width: 0;
			font-size: 0.78rem;
		}

		.post-title {
			font-size: 0.95rem;
			line-height: 1.45;
		}
	}

	@media (max-width: 420px) {
		.intro-section {
			flex-direction: column;
		}

		.section-header {
			flex-direction: column;
		}

		.section-link {
			width: 100%;
			justify-content: center;
		}
	}
</style>
