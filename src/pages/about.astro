---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { AUTHOR_DESCRIPTION, AUTHOR_NAME, AUTHOR_TITLE, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={AUTHOR_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<article class="prose">
				<header class="page-header">
					<p class="eyebrow">About</p>
					<h1 class="page-title">{AUTHOR_NAME}</h1>
					<p class="lead">{AUTHOR_TITLE}</p>
				</header>

				<p>
					{AUTHOR_DESCRIPTION}
				</p>

				<p>
					This site is a quiet place for technical notes, project write-ups, and essays about
					building reliable software. The design stays intentionally minimal so the writing remains
					the primary interface.
				</p>

				<h2>What I write about</h2>
				<ul>
					<li>Backend systems and service design.</li>
					<li>Elixir, Phoenix, distributed systems, and operational tooling.</li>
					<li>NixOS, developer environments, and pragmatic automation.</li>
				</ul>

				<h2>Contact</h2>
				<p>
					The best starting point is the links in the footer. For project details, see the
					<a href="/projects">projects page</a>.
				</p>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
  main {
    max-width: 640px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }

	.page-header {
		border-bottom: 1px solid var(--border-color);
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
	}

  .page-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0 0 2rem 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-primary);
  }

  .page-title::before {
    content: '';
    width: 4px;
    height: 1.75rem;
    background: linear-gradient(180deg, var(--accent), #8b5cf6);
    border-radius: 2px;
  }

	.eyebrow {
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		margin-bottom: 0.35rem;
		text-transform: uppercase;
	}

	.lead {
		color: var(--text-muted);
		font-size: 1.05rem;
		margin: 0;
	}

	@media (max-width: 640px) {
		main {
			max-width: 100%;
			padding: 1.75rem 1rem 3.5rem;
		}

		.page-header {
			margin-bottom: 1.5rem;
			padding-bottom: 1.25rem;
		}

		.page-header h1 {
			font-size: 1.85rem;
		}

		.lead {
			font-size: 0.98rem;
			line-height: 1.55;
		}

		.prose {
			font-size: 0.96rem;
			line-height: 1.7;
		}

		.prose h2 {
			font-size: 1.2rem;
			margin-top: 1.65rem;
		}

		.prose ul {
			padding-left: 1.15rem;
		}
	}
</style>
